{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "PathSync AI Permanent Visual Design System Tokens",
  "version": "1.0.0",
  "description": "Permanent design tokens for PathSync AI inspired by the modern education/SaaS reference standard.",
  "color": {
    "brand": {
      "primary": { "value": "#0A6C58", "description": "Core brand deep teal/green for primary actions, prominent badges, active states" },
      "primaryHover": { "value": "#085444", "description": "Darker teal for hover states" },
      "primaryActive": { "value": "#064034", "description": "Pressed/active primary state" },
      "primarySubtle": { "value": "#EBF7F3", "description": "Very soft green/mint tint for pill badges, icon containers, highlights" },
      "primaryMuted": { "value": "#C2EADB", "description": "Soft teal border and muted accent" },
      "primaryDark": { "value": "#06392F", "description": "Deep forest teal for hero spotlight cards, impact banners, and dark CTA sections" },
      "primaryDarker": { "value": "#04261F", "description": "Deepest forest navy for dark footers" }
    },
    "accent": {
      "mint": { "value": "#10B981", "description": "Vibrant emerald green for positive accents and score indicators" },
      "lime": { "value": "#84CC16", "description": "Fresh lime accent for high-energy tags" },
      "tealBright": { "value": "#14B8A6", "description": "Bright teal highlight" }
    },
    "text": {
      "primary": { "value": "#0F172A", "description": "Dark navy/charcoal for prominent headings and high-contrast text" },
      "secondary": { "value": "#475569", "description": "Clean muted slate for readable body paragraphs" },
      "tertiary": { "value": "#64748B", "description": "Muted gray for secondary labels, metadata, dates, and captions" },
      "quaternary": { "value": "#94A3B8", "description": "Disabled text and subtle icon strokes" },
      "inverse": { "value": "#FFFFFF", "description": "White text on deep teal or dark surfaces" },
      "inverseMuted": { "value": "#CBD5E1", "description": "Muted text on deep teal or dark surfaces" }
    },
    "background": {
      "canvas": { "value": "#FFFFFF", "description": "Clean white primary canvas" },
      "surface": { "value": "#FFFFFF", "description": "Clean card surface" },
      "alternate": { "value": "#F8FAFC", "description": "Very light neutral background for alternating sections" },
      "subtle": { "value": "#F1F5F9", "description": "Soft light gray container background" },
      "forest": { "value": "#06392F", "description": "Signature deep forest container background" },
      "dark": { "value": "#0B132B", "description": "Dark navy backdrop" }
    },
    "border": {
      "subtle": { "value": "#F1F5F9", "description": "Minimal divider border" },
      "default": { "value": "#E2E8F0", "description": "Subtle card and input border" },
      "strong": { "value": "#CBD5E1", "description": "High-contrast border" },
      "brand": { "value": "#A7DBC8", "description": "Brand-tinted border for active cards and pills" },
      "focus": { "value": "#0A6C58", "description": "Focus ring color" }
    },
    "semantic": {
      "success": { "value": "#059669", "subtle": "#ECFDF5" },
      "warning": { "value": "#D97706", "subtle": "#FFFBEB" },
      "danger": { "value": "#DC2626", "subtle": "#FEF2F2" },
      "info": { "value": "#0284C7", "subtle": "#F0F9FF" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "mono": "'JetBrains Mono', Menlo, Consolas, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem",
      "6xl": "3.75rem"
    },
    "fontWeight": {
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "extrabold": "800"
    },
    "lineHeight": {
      "tight": "1.2",
      "snug": "1.35",
      "normal": "1.5",
      "relaxed": "1.65"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px"
  },
  "radii": {
    "xs": "4px",
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "32px",
    "full": "9999px"
  },
  "shadows": {
    "xs": "0 1px 2px 0 rgba(15, 23, 42, 0.05)",
    "sm": "0 2px 4px 0 rgba(15, 23, 42, 0.04), 0 1px 2px 0 rgba(15, 23, 42, 0.02)",
    "md": "0 4px 12px -2px rgba(15, 23, 42, 0.06), 0 2px 6px -1px rgba(15, 23, 42, 0.04)",
    "lg": "0 12px 24px -4px rgba(15, 23, 42, 0.08), 0 4px 8px -2px rgba(15, 23, 42, 0.04)",
    "xl": "0 20px 32px -8px rgba(15, 23, 42, 0.12), 0 8px 16px -4px rgba(15, 23, 42, 0.06)",
    "brand": "0 8px 20px -4px rgba(10, 108, 88, 0.25)"
  }
}

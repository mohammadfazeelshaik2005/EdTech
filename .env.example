# ============================================================================
# PathSync AI - Database & Supabase Environment Configuration
# ============================================================================

# OPTION 1: Supabase Hosted PostgreSQL (Recommended for Production & Cloud)
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in the Supabase SQL Editor
# 3. Run supabase/seed.sql in the Supabase SQL Editor
# 4. Fill in your Project URL and Public Anon Key below:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# OPTION 2: Local Standalone PostgreSQL (Docker / Local Server)
# 1. Run: docker compose up -d (or run database/standalone-postgres.sql in psql)
# Database Name: pathsync_db
# Port: 5432
# User: pathsync
# Password: pathsync_password
# pgAdmin UI: http://localhost:5050 (admin@pathsync.ai / admin)

# ============================================================================
# Google Gemini AI Configuration (Server-Side Secrets Only)
# ============================================================================
# IMPORTANT: Never prefix with VITE_ or expose to the frontend/browser.
# This key is read exclusively on the server by the backend API proxy or Supabase Edge Function.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Configurable Gemini Model Name (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

